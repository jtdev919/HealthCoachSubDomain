---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'AI Health Coach App',
  description = 'AI Health Coach connects your wearable data, labs, and biometrics into one place — then uses AI to tell you what to do next.',
  ogImage = '/og.svg'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

/*
  Analytics.

  This slot previously held a <script src> pointing at
  costmgmt-web.<...>.eastus.azurecontainerapps.io, the cost-management container app. That host
  no longer resolves (DNS NXDOMAIN, verified 2026-10-09), so every page load has been requesting
  a script from a deleted resource and recording nothing. The tag being present is precisely why
  nobody noticed: the layout read as instrumented.

  It is now gated on an env var. Set PUBLIC_PLAUSIBLE_DOMAIN in the Static Web App configuration
  once the Plausible (or Fathom) account exists; until then no analytics script is emitted at all,
  which is at least honest about the fact that nothing is being measured.
*/
const analyticsDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/healthcoachapp-icon.png" />
    <link rel="apple-touch-icon" href="/healthcoachapp-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {analyticsDomain && (
      <script
        is:inline
        defer
        data-domain={analyticsDomain}
        src="https://plausible.io/js/script.outbound-links.js"
      ></script>
    )}
  </head>
  <body>
    <div class="nav">
      <div class="container">
        <Nav />
      </div>
    </div>

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
