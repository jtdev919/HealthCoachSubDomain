---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'AI Health Coach | Stop Guessing. Start Proving.';
const description = 'Upload labs, sync wearables, track supplements, run experiments. AI analyzes your real data — 70+ biomarkers, biological age, N=1 protocols. Available on iOS and Android.';
---

<BaseLayout title={title} description={description}>

  <!-- ===== BANNER ===== -->
  <section class="banner-section">
    <div class="container" style="text-align:center;">
      <img
        src="/screenshots/hero-banner.png"
        alt="Your AI-Powered Health Command Center — Wearables, nutrition, labs, supplements and AI coaching all in one app"
        style="width:100%; max-width:960px; border-radius:16px; margin:0 auto;"
        loading="eager"
      />
    </div>
  </section>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container">
      <div class="hero-split">
        <div class="hero-text">
          <div class="kicker">
            <span aria-hidden="true">&#9679;</span>
            Oura &middot; Garmin &middot; WHOOP &middot; Apple Health &middot; 70+ biomarkers
          </div>

          <h1>Stop Guessing.<br/>Start Proving.</h1>

          <p class="lead">
            Upload your labs. Sync your wearables. Track your supplements.
            AI Health Coach analyzes your real data to show what&rsquo;s working,
            what&rsquo;s not, and what to change next.
          </p>

          <div class="store-badges">
            <a href="https://play.google.com/store/apps/details?id=com.teknicalsolutionz.HealthCoachApp" target="_blank" rel="noopener" data-track="cta-google-play">
              <img src="/badges/google-play-badge.svg" alt="Get it on Google Play" height="60" />
            </a>
            <a href="https://apps.apple.com/us/app/ai-health-coach-app/id6758858875" target="_blank" rel="noopener" data-track="cta-app-store">
              <img src="/badges/app-store-badge.svg" alt="Download on the App Store" height="60" />
            </a>
          </div>
          <a href="https://youtu.be/385-z2bLsMs" target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:8px; margin-top:16px; color:var(--blue); font-weight:600; font-size:0.95rem; text-decoration:none;">
            &#9654; Watch the Demo
          </a>
        </div>
        <div class="hero-screenshot">
          <div class="phone-frame">
            <img src="/screenshots/dashboard-hero.png" alt="AI Health Coach dashboard showing HRV, RHR, Sleep, Recovery Score, and Body Composition" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WEARABLES ===== -->
  <section class="section" id="features">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Connect Everything</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Sync your ring, watch, and health apps. All your biometric data in one dashboard &mdash;
            HRV, sleep stages, recovery, steps, body composition.
          </p>
          <div class="pills" style="margin-top:12px;">
            <a class="pill pill-lg" href="/garmin">Garmin</a>
            <a class="pill pill-lg" href="/whoop">WHOOP</a>
            <span class="pill pill-lg">Oura</span>
            <span class="pill pill-lg">Apple Health</span>
            <span class="pill pill-lg">Health Connect</span>
            <span class="pill pill-lg">Withings</span>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/wearables.png" alt="Wearable integrations showing Oura, Garmin, WHOOP connected" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LABS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Upload Labs. See What Moves.</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Upload any lab PDF. AI extracts 70+ biomarkers in seconds and shows you
            optimal vs clinical ranges &mdash; not just &ldquo;normal.&rdquo;
            Track trends across multiple panels. See which supplements actually moved the needle.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Longevity-optimal ranges</h3>
              <p>Standard labs say &ldquo;normal.&rdquo; We show you what&rsquo;s optimal for longevity &mdash;
                 ApoB under 60, fasting glucose under 85, hs-CRP under 0.5.</p>
            </div>
            <div class="feature">
              <h3>Biomarker trend charts</h3>
              <p>See every marker trending over 3, 6, and 12 months. Spot improvements
                 and regressions your doctor won&rsquo;t catch in a single visit.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/labs.png" alt="Lab results with biomarker analysis and optimal ranges" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ASK AI ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Ask Your AI Health Coach</h2>
          <p class="sub" style="margin: 0 0 16px;">
            &ldquo;Why is my HRV trending down?&rdquo; &mdash; answered using your actual data.
            Not a generic chatbot. Your AI sees your labs, wearables, supplements, and
            entire health history to give you personalized answers.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>20+ data sources in context</h3>
              <p>Labs, wearables, supplements, symptoms, workouts, nutrition, food sensitivities,
                 protocols &mdash; all connected. The AI sees the full picture.</p>
            </div>
            <div class="feature">
              <h3>AES-256 encrypted</h3>
              <p>Your health data is encrypted at rest. Every question and answer is private to you.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/ask-ai.png" alt="Ask AI Health Coach a health question with personalized response" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== NUTRITION ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">AI Meal Plans &amp; Macro Tracking</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Log food by barcode, search, or manual entry. AI builds a 7-day meal plan
            around your macro targets with a grocery list. Order groceries from Kroger
            right in the app.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Barcode food scanner</h3>
              <p>Scan any food product. Instant nutrition data from Open Food Facts and Nutritionix.</p>
            </div>
            <div class="feature">
              <h3>Food sensitivity tracking</h3>
              <p>Import Viome and Everlywell results. Flag food reactions. AI detects patterns
                 and warns you before you eat trigger foods.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/nutrition.png" alt="Nutrition tracking with macro targets and food logging" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CGM & GLUCOSE ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Know What Every Meal Does to Your Blood Sugar</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Import CGM data from Abbott Lingo or Apple Health. See your daily averages,
            peak glucose, time-in-range, and metabolic health score. The app learns
            which foods spike YOUR blood sugar and shows the impact right on each meal.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Personal food responses</h3>
              <p>Every meal gets a glucose impact score. Chicken Alfredo Pasta: +102 mg/dL.
                 Greek Yogurt: +43 mg/dL. Your data, your body.</p>
            </div>
            <div class="feature">
              <h3>Untagged spike detection</h3>
              <p>See a glucose spike with no meal logged? The app flags it and lets you tag
                 what you ate &mdash; building your food response profile over time.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-pair">
            <div class="phone-frame">
              <img src="/screenshots/glucose-dashboard.jpg" alt="Glucose dashboard showing 92 avg, 139 peak, 96% time in range with trend chart" loading="lazy" />
            </div>
            <div class="phone-frame">
              <img src="/screenshots/glucose-food-impacts.jpg" alt="Food glucose impact profiles showing Chicken Alfredo Pasta +102 mg/dL spike" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WORKOUTS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Train Smarter</h2>
          <p class="sub" style="margin: 0 0 16px;">
            AI generates your workout plan. Calculates your working weight from your e1RM.
            Logs every set. Analyzes your session after. Tells you when to go heavier
            and when to back off.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>1,394 exercise demos</h3>
              <p>Animated GIF demonstrations for every exercise. Muscle-specific stretches between sets.</p>
            </div>
            <div class="feature">
              <h3>Post-workout AI analyzer</h3>
              <p>After every session, AI compares your actual performance to the plan and gives
                 coaching recommendations.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/exercise-demos.png" alt="Exercise demos with animated GIFs and workout logging" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SUPPLEMENTS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Track Your Stack. Prove What Works.</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Scan a supplement barcode. See interactions, optimal timing, and evidence tiers.
            Track your entire stack — then see which supplements actually moved your biomarkers.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Interaction checker</h3>
              <p>Check supplement-drug and supplement-supplement interactions before you take them.</p>
            </div>
            <div class="feature">
              <h3>Timing optimization</h3>
              <p>93+ supplements with optimal timing data &mdash; morning vs evening, with food vs empty stomach.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/interaction-checker.jpg" alt="Supplement interaction checker showing zinc and iron compete for absorption" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BIOMARKER IMPACT ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">See What Moves the Needle</h2>
          <p class="sub" style="margin: 0 0 16px;">
            For every supplement you track, AI compares your lab results before vs after.
            Real data showing which supplements actually changed your biomarkers.
          </p>
          <div class="feature">
            <h3>Before &amp; after proof</h3>
            <p>Quercetin dropped hs-CRP from 1.5 to 0.5. Iron Bisglycinate boosted Ferritin from 25 to 58.
               No guessing &mdash; just data.</p>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/biomarker-impact.jpg" alt="Biomarker Impact showing supplement before and after lab results" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BIOLOGICAL AGE ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Know Your Real Age</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Your biological age is computed from HRV, resting heart rate, VO2 max, sleep,
            fasting glucose, HbA1c, inflammation markers, and vitamin D.
            Watch it drop as you optimize.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Longevity index</h3>
              <p>A single 0&ndash;100 score across cardiovascular, metabolic, and recovery pillars. Letter graded A+ to F.</p>
            </div>
            <div class="feature">
              <h3>Epigenetic clock import</h3>
              <p>Import TruAge, GrimAge, or Elysium results for DNA methylation-based biological age.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/biological-age.png" alt="Biological age score showing years younger than chronological age" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== RESEARCH DIGEST ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Research That&rsquo;s Actually About You</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Every week, AI scans your wearable data, lab results, supplements, and training
            &mdash; then finds peer-reviewed research that applies to YOUR numbers.
            Not generic health news. Evidence tied to your data.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Evidence-graded citations</h3>
              <p>Every bullet is tagged with its evidence tier &mdash; Meta-Analysis, RCT, or
                 Cohort Study &mdash; plus the journal and year. No bro-science.</p>
            </div>
            <div class="feature">
              <h3>Your data &rarr; the literature</h3>
              <p>&ldquo;Your HRV averages 48ms&rdquo; &rarr; a Lancet meta-analysis on HRV and mortality.
                 &ldquo;Your vitamin D improved to 62&rdquo; &rarr; testosterone optimization research.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-pair">
            <div class="phone-frame">
              <img src="/screenshots/research-digest-header.jpg" alt="Weekly Research Digest showing personalized longevity research matched to user data" loading="lazy" />
            </div>
            <div class="phone-frame">
              <img src="/screenshots/research-digest-bullets.jpg" alt="Research digest bullets with evidence tiers linking user data to peer-reviewed studies" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROTOCOLS ===== -->
  <style>
    .three-col-protocols { display:grid; grid-template-columns:1fr 1.2fr 1fr; gap:24px; align-items:center; }
    @media (max-width:900px) { .three-col-protocols { grid-template-columns:1fr; } .three-col-protocols .phone-frame { max-width:320px; margin:0 auto; } }
  </style>
  <section class="section">
    <div class="container">
      <div class="three-col-protocols">
        <div class="phone-frame">
          <img src="/screenshots/experiment-library.jpg" alt="Experiment Library with curated biohacking protocols" loading="lazy" />
        </div>
        <div style="text-align:center;">
          <h2 style="margin-top:0;">Run Your Own Experiments</h2>
          <p class="sub" style="margin: 0 auto 16px;">
            Browse curated protocols or design your own. Track daily. Get a statistical analysis
            showing whether it actually worked &mdash; or was just noise.
          </p>
          <div class="feature" style="text-align:left;">
            <h3>Experiment library</h3>
            <p>Curated biohacking protocols with evidence tiers. Mitochondrial, hormonal, metabolic, cognitive. Pick one &mdash; we track everything.</p>
          </div>
          <div class="feature" style="text-align:left; margin-top:12px;">
            <h3>Dose calculator</h3>
            <p>Peptide reconstitution math, BAC water volume, injection dose &mdash; calculated for you. Plan titration schedules with concentration curves.</p>
          </div>
        </div>
        <div class="phone-frame">
          <img src="/screenshots/dose-calculator.jpg" alt="Peptide dose calculator with injection and BAC water inputs" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROTOCOL ANALYTICS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Prove What Works. Drop What Doesn&rsquo;t.</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Run a protocol. Track intake daily. When it&rsquo;s done, get a full statistical
            report comparing your baseline biometrics to during-protocol data.
            No guessing &mdash; just numbers.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Before vs after, quantified</h3>
              <p>HRV up 36%. Resting heart rate down 17%. Sleep improved.
                 Confidence score: 100%. The protocol worked &mdash; and here&rsquo;s the proof.</p>
            </div>
            <div class="feature">
              <h3>Confounders detected</h3>
              <p>Travel, illness, alcohol, missing data days &mdash; all flagged automatically
                 so you know what might have skewed the results.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-pair">
            <div class="phone-frame">
              <img src="/screenshots/protocol-detail.jpg" alt="Completed Ashwagandha KSM-66 protocol with hypothesis, items, and intake tracking" loading="lazy" />
            </div>
            <div class="phone-frame">
              <img src="/screenshots/protocol-analytics.jpg" alt="Protocol analytics report showing 100% confidence, HRV improved 36%, RHR improved 17%" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== REAL RESULTS ===== -->
  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">Real results. Not hypotheticals.</h2>
      <p class="sub" style="text-align:center; margin: 0 auto 24px;">
        Real discoveries made by AI Health Coach analyzing real health data.
      </p>

      <div class="grid cols-2" style="max-width:900px; margin:0 auto;">
        <div class="card pad">
          <h3 style="margin-top:0;">The iron deficiency no one caught</h3>
          <p>
            After 2 years of declining energy on TRT, the clinic kept saying
            &ldquo;your bloodwork looks amazing.&rdquo; AI Health Coach connected what they didn&rsquo;t:
            frequent blood donations were depleting iron stores.
          </p>
          <p>
            <strong>Ferritin: 18 ng/mL</strong> (ref 30&ndash;400). Flagged Low.
            Six weeks of iron bisglycinate later &mdash; energy returned.
          </p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">The missing hormone protocol</h3>
          <p>
            A clinic dropped HCG from a TRT regimen, saying it wasn&rsquo;t needed.
            Over the following years: strength declined, libido disappeared, mood tanked.
          </p>
          <p>
            <strong>LH: &lt;0.3</strong> (ref 1.7&ndash;8.6). <strong>FSH: &lt;0.3</strong> (ref 1.5&ndash;12.4).
            AI Health Coach flagged it. Back on HCG &mdash; recovering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing section: uncomment when subscriptions go live
  <section class="section" id="pricing">
    ...pricing cards...
  </section>
  -->

  <!-- ===== PRIVACY ===== -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Your data. Your control.</h2>
      <div class="grid cols-3" style="max-width:800px; margin:12px auto 0;">
        <div class="feature" style="text-align:center;">
          <h3>AES-256 encryption</h3>
          <p>All health data encrypted at rest. Azure Key Vault for key management. HIPAA-ready architecture.</p>
        </div>
        <div class="feature" style="text-align:center;">
          <h3>You control everything</h3>
          <p>Connect and disconnect wearables anytime. Delete all data with one tap. Full data export.</p>
        </div>
        <div class="feature" style="text-align:center;">
          <h3>We never sell your data</h3>
          <p>No data brokers. No ad targeting. No third-party access. Your health data stays yours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOUNDER ===== -->
  <section class="section">
    <div class="container">
      <div class="card pad founder-card">
        <h2 style="margin-top:0;">Why I built this</h2>
        <p>
          I was on TRT for 6 years, tracking everything across Garmin, bloodwork panels, and supplement logs.
          For the last 2 years my energy and stamina were declining. Every visit to the clinic:
          &ldquo;Your bloodwork looks amazing.&rdquo; But I felt terrible.
        </p>
        <p>
          I didn&rsquo;t need another app. I needed an AI that could see the full picture.
          Within weeks it caught what the clinic missed for 2 years: iron deficiency from required blood
          donations, and hormone imbalances from a protocol change they said &ldquo;wouldn&rsquo;t matter.&rdquo;
        </p>
        <p style="margin-bottom:0;">
          <strong>- Joe, Founder</strong><br/>
          <a href="https://www.instagram.com/josephtolandsr/" target="_blank" rel="noopener" style="color: var(--blue);">
            Follow the journey on Instagram &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== WHAT'S NEW ===== -->
  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">Coming in the Next Release</h2>
      <p class="sub" style="text-align:center; margin: 0 auto 28px; max-width:55ch;">
        Shipping soon.
      </p>

      <div class="grid cols-3" style="max-width:900px; margin:0 auto 16px;">
        <div class="card pad">
          <h3 style="margin-top:0;">Health Events</h3>
          <p>Log blood donations, surgeries, medication changes. Events appear as markers on biomarker trend charts.</p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">Function Health Import</h3>
          <p>Upload your 100+ biomarker PDF multiple times as results come in. Smart dedup &mdash; no duplicates.</p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">Clinician Notes AI</h3>
          <p>Upload clinician notes PDFs. AI extracts key findings, recommendations, and follow-up items.</p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">Everlywell + Viome</h3>
          <p>Upload food sensitivity reports from both providers. Cross-referenced foods get stronger warnings.</p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">Post-Workout AI Analyzer</h3>
          <p>After every session, AI compares your performance to the plan &mdash; volume, rest periods, RPE &mdash; and gives actionable coaching.</p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">Instacart Grocery Integration</h3>
          <p>One tap sends your meal plan grocery list or recipe ingredients to Instacart. Pick any retailer, no account linking.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ROADMAP ===== -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <h2 style="text-align:center;">On the Roadmap</h2>
      <p class="sub" style="text-align:center; margin: 0 auto 28px; max-width:55ch;">
        What we&rsquo;re building next.
      </p>

      <div class="grid cols-3" style="max-width:900px; margin:0 auto 40px;">
        <div class="card pad" style="border-left:3px solid var(--blue);">
          <h3 style="margin-top:0;">Stress Management</h3>
          <p>Guided breathing exercises, meditation tracking, and AI stress pattern detection from wearable data.</p>
        </div>
        <div class="card pad" style="border-left:3px solid var(--blue);">
