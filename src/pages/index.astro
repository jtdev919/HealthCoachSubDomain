---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'AI Health Coach | Stop Guessing. Start Proving.';
const description = 'Upload labs, sync wearables, track supplements, run experiments. AI analyzes your real data — 70+ biomarkers, biological age, N=1 protocols. Available on iOS and Android.';
---

<BaseLayout title={title} description={description}>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container">
      <div class="hero-split">
        <div class="hero-text">
          <div class="kicker">
            <span aria-hidden="true">&#9679;</span>
            Oura &middot; Garmin &middot; WHOOP &middot; Apple Health &middot; 70+ biomarkers
          </div>

          <h1>Stop Guessing.<br/>Start Proving.</h1>

          <p class="lead">
            Upload your labs. Sync your wearables. Track your supplements.
            AI Health Coach analyzes your real data to show what&rsquo;s working,
            what&rsquo;s not, and what to change next.
          </p>

          <div class="store-badges">
            <a href="https://play.google.com/store/apps/details?id=com.teknicalsolutionz.HealthCoachApp" target="_blank" rel="noopener" data-track="cta-google-play">
              <img src="/badges/google-play-badge.svg" alt="Get it on Google Play" height="60" />
            </a>
            <a href="https://apps.apple.com/us/app/ai-health-coach-app/id6758858875" target="_blank" rel="noopener" data-track="cta-app-store">
              <img src="/badges/app-store-badge.svg" alt="Download on the App Store" height="60" />
            </a>
          </div>
        </div>
        <div class="hero-screenshot">
          <div class="phone-frame">
            <img src="/screenshots/dashboard-hero.png" alt="AI Health Coach dashboard showing HRV, RHR, Sleep, Recovery Score, and Body Composition" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WEARABLES ===== -->
  <section class="section" id="features">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Connect Everything</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Sync your ring, watch, and health apps. All your biometric data in one dashboard &mdash;
            HRV, sleep stages, recovery, steps, body composition.
          </p>
          <div class="pills" style="margin-top:12px;">
            <a class="pill pill-lg" href="/garmin">Garmin</a>
            <a class="pill pill-lg" href="/whoop">WHOOP</a>
            <span class="pill pill-lg">Oura</span>
            <span class="pill pill-lg">Apple Health</span>
            <span class="pill pill-lg">Health Connect</span>
            <span class="pill pill-lg">Withings</span>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/wearables.png" alt="Wearable integrations showing Oura, Garmin, WHOOP connected" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LABS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Upload Labs. See What Moves.</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Upload any lab PDF. AI extracts 70+ biomarkers in seconds and shows you
            optimal vs clinical ranges &mdash; not just &ldquo;normal.&rdquo;
            Track trends across multiple panels. See which supplements actually moved the needle.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Longevity-optimal ranges</h3>
              <p>Standard labs say &ldquo;normal.&rdquo; We show you what&rsquo;s optimal for longevity &mdash;
                 ApoB under 60, fasting glucose under 85, hs-CRP under 0.5.</p>
            </div>
            <div class="feature">
              <h3>Biomarker trend charts</h3>
              <p>See every marker trending over 3, 6, and 12 months. Spot improvements
                 and regressions your doctor won&rsquo;t catch in a single visit.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/labs.png" alt="Lab results with biomarker analysis and optimal ranges" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ASK AI ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Ask Your AI Health Coach</h2>
          <p class="sub" style="margin: 0 0 16px;">
            &ldquo;Why is my HRV trending down?&rdquo; &mdash; answered using your actual data.
            Not a generic chatbot. Your AI sees your labs, wearables, supplements, and
            entire health history to give you personalized answers.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>20+ data sources in context</h3>
              <p>Labs, wearables, supplements, symptoms, workouts, nutrition, food sensitivities,
                 protocols &mdash; all connected. The AI sees the full picture.</p>
            </div>
            <div class="feature">
              <h3>AES-256 encrypted</h3>
              <p>Your health data is encrypted at rest. Every question and answer is private to you.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/ask-ai.png" alt="Ask AI Health Coach a health question with personalized response" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== NUTRITION ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">AI Meal Plans &amp; Macro Tracking</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Log food by barcode, search, or manual entry. AI builds a 7-day meal plan
            around your macro targets with a grocery list. Order groceries from Kroger
            right in the app.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Barcode food scanner</h3>
              <p>Scan any food product. Instant nutrition data from Open Food Facts and Nutritionix.</p>
            </div>
            <div class="feature">
              <h3>Food sensitivity tracking</h3>
              <p>Import Viome and Everlywell results. Flag food reactions. AI detects patterns
                 and warns you before you eat trigger foods.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/nutrition.png" alt="Nutrition tracking with macro targets and food logging" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WORKOUTS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Train Smarter</h2>
          <p class="sub" style="margin: 0 0 16px;">
            AI generates your workout plan. Calculates your working weight from your e1RM.
            Logs every set. Analyzes your session after. Tells you when to go heavier
            and when to back off.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>1,394 exercise demos</h3>
              <p>Animated GIF demonstrations for every exercise. Muscle-specific stretches between sets.</p>
            </div>
            <div class="feature">
              <h3>Post-workout AI analyzer</h3>
              <p>After every session, AI compares your actual performance to the plan and gives
                 coaching recommendations.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/exercise-demos.png" alt="Exercise demos with animated GIFs and workout logging" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SUPPLEMENTS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Track Your Stack</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Scan a supplement barcode. See interactions, optimal timing, and evidence tiers.
            Track your entire stack and correlate it against your biomarkers.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Interaction checker</h3>
              <p>Check supplement-drug and supplement-supplement interactions before you take them.</p>
            </div>
            <div class="feature">
              <h3>Timing optimization</h3>
              <p>93+ supplements with optimal timing data &mdash; morning vs evening, with food vs empty stomach.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/supplements.png" alt="Supplement tracking with barcode scanning and interaction checking" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BIOLOGICAL AGE ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Know Your Real Age</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Your biological age is computed from HRV, resting heart rate, VO2 max, sleep,
            fasting glucose, HbA1c, inflammation markers, and vitamin D.
            Watch it drop as you optimize.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Longevity index</h3>
              <p>A single 0&ndash;100 score across cardiovascular, metabolic, and recovery pillars. Letter graded A+ to F.</p>
            </div>
            <div class="feature">
              <h3>Epigenetic clock import</h3>
              <p>Import TruAge, GrimAge, or Elysium results for DNA methylation-based biological age.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/biological-age.png" alt="Biological age score showing years younger than chronological age" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROTOCOLS ===== -->
  <section class="section">
    <div class="container">
      <div class="screenshot-row screenshot-row-reverse">
        <div class="screenshot-row-content">
          <h2 style="margin-top:0;">Run Your Own Experiments</h2>
          <p class="sub" style="margin: 0 0 16px;">
            Design an N=1 protocol. Track daily. Get a statistical analysis
            showing whether it actually worked &mdash; or was just noise.
          </p>
          <div class="grid" style="gap:12px;">
            <div class="feature">
              <h3>Titration planner</h3>
              <p>Plan your dose schedule. See concentration curves. Log side effects at each level.</p>
            </div>
            <div class="feature">
              <h3>Statistical analysis</h3>
              <p>After your protocol ends, get a report with before/after comparison and confidence scores.</p>
            </div>
          </div>
        </div>
        <div class="screenshot-row-image">
          <div class="phone-frame">
            <img src="/screenshots/titration-planner.jpg" alt="Titration protocol planner with dose scheduling" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== REAL RESULTS ===== -->
  <section class="section">
    <div class="container">
      <h2 style="text-align:center;">Real results. Not hypotheticals.</h2>
      <p class="sub" style="text-align:center; margin: 0 auto 24px;">
        Real discoveries made by AI Health Coach analyzing real health data.
      </p>

      <div class="grid cols-2" style="max-width:900px; margin:0 auto;">
        <div class="card pad">
          <h3 style="margin-top:0;">The iron deficiency no one caught</h3>
          <p>
            After 2 years of declining energy on TRT, the clinic kept saying
            &ldquo;your bloodwork looks amazing.&rdquo; AI Health Coach connected what they didn&rsquo;t:
            frequent blood donations were depleting iron stores.
          </p>
          <p>
            <strong>Ferritin: 18 ng/mL</strong> (ref 30&ndash;400). Flagged Low.
            Six weeks of iron bisglycinate later &mdash; energy returned.
          </p>
        </div>
        <div class="card pad">
          <h3 style="margin-top:0;">The missing hormone protocol</h3>
          <p>
            A clinic dropped HCG from a TRT regimen, saying it wasn&rsquo;t needed.
            Over the following years: strength declined, libido disappeared, mood tanked.
          </p>
          <p>
            <strong>LH: &lt;0.3</strong> (ref 1.7&ndash;8.6). <strong>FSH: &lt;0.3</strong> (ref 1.5&ndash;12.4).
            AI Health Coach flagged it. Back on HCG &mdash; recovering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="section" id="pricing">
    <div class="container">
      <h2 style="text-align:center;">Plans &amp; Pricing</h2>
      <p class="sub" style="text-align:center; margin: 0 auto 24px;">
        Start free. Upgrade when you&rsquo;re ready.
      </p>

      <div class="grid cols-3" style="max-width:960px; margin:0 auto;">
        <div class="card pad" style="text-align:center;">
          <h3 style="margin-top:0;">Free</h3>
          <div style="font-size:2rem; font-weight:700; margin:8px 0;">$0</div>
          <p class="small" style="margin-bottom:16px;">Forever</p>
          <ul style="text-align:left; font-size:0.85rem; list-style:none; padding:0;">
            <li style="padding:4px 0;">&#10003; Full wearable sync</li>
            <li style="padding:4px 0;">&#10003; Dashboard &amp; recovery score</li>
            <li style="padding:4px 0;">&#10003; Lab upload (3/month)</li>
            <li style="padding:4px 0;">&#10003; Supplement tracking (10)</li>
            <li style="padding:4px 0;">&#10003; 12 AI requests/month</li>
            <li style="padding:4px 0;">&#10003; Blood pressure &amp; habits</li>
            <li style="padding:4px 0;">&#10003; Community access</li>
          </ul>
        </div>

        <div class="card pad" style="text-align:center; border-color: var(--blue);">
          <h3 style="margin-top:0; color: var(--blue);">Core</h3>
          <div style="font-size:2rem; font-weight:700; margin:8px 0;">$12.99</div>
          <p class="small" style="margin-bottom:16px;">per month &middot; $9.99/mo annual</p>
          <ul style="text-align:left; font-size:0.85rem; list-style:none; padding:0;">
            <li style="padding:4px 0;">&#10003; Everything in Free</li>
            <li style="padding:4px 0;">&#10003; 75 AI requests/month</li>
            <li style="padding:4px 0;">&#10003; AI workout &amp; meal plans</li>
            <li style="padding:4px 0;">&#10003; Biomarker trend analysis</li>
            <li style="padding:4px 0;">&#10003; CGM glucose monitoring</li>
            <li style="padding:4px 0;">&#10003; N=1 protocol tracking</li>
            <li style="padding:4px 0;">&#10003; Monthly scorecard</li>
            <li style="padding:4px 0;">&#10003; Data export</li>
          </ul>
        </div>

        <div class="card pad" style="text-align:center; border-color: var(--blue); position:relative;">
          <div style="position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:var(--blue); color:white; padding:2px 16px; border-radius:12px; font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em;">Popular</div>
          <h3 style="margin-top:0; color: var(--blue);">Pro</h3>
          <div style="font-size:2rem; font-weight:700; margin:8px 0;">$24.99</div>
          <p class="small" style="margin-bottom:16px;">per month &middot; $19.99/mo annual</p>
          <ul style="text-align:left; font-size:0.85rem; list-style:none; padding:0;">
            <li style="padding:4px 0;">&#10003; Everything in Core</li>
            <li style="padding:4px 0;">&#10003; Unlimited AI</li>
            <li style="padding:4px 0;">&#10003; Pharmacokinetics &amp; titration</li>
            <li style="padding:4px 0;">&#10003; Fertility tracking</li>
            <li style="padding:4px 0;">&#10003; Grocery ordering (Kroger)</li>
            <li style="padding:4px 0;">&#10003; Viome &amp; food sensitivity</li>
            <li style="padding:4px 0;">&#10003; Advanced training analytics</li>
            <li style="padding:4px 0;">&#10003; Longevity &amp; cardio age</li>
            <li style="padding:4px 0;">&#10003; Unlimited data export</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRIVACY ===== -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Your data. Your control.</h2>
      <div class="grid cols-3" style="max-width:800px; margin:12px auto 0;">
        <div class="feature" style="text-align:center;">
          <h3>AES-256 encryption</h3>
          <p>All health data encrypted at rest. Azure Key Vault for key management. HIPAA-ready architecture.</p>
        </div>
        <div class="feature" style="text-align:center;">
          <h3>You control everything</h3>
          <p>Connect and disconnect wearables anytime. Delete all data with one tap. Full data export.</p>
        </div>
        <div class="feature" style="text-align:center;">
          <h3>We never sell your data</h3>
          <p>No data brokers. No ad targeting. No third-party access. Your health data stays yours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOUNDER ===== -->
  <section class="section">
    <div class="container">
      <div class="card pad founder-card">
        <h2 style="margin-top:0;">Why I built this</h2>
        <p>
          I was on TRT for 6 years, tracking everything across Garmin, bloodwork panels, and supplement logs.
          For the last 2 years my energy and stamina were declining. Every visit to the clinic:
          &ldquo;Your bloodwork looks amazing.&rdquo; But I felt terrible.
        </p>
        <p>
          I didn&rsquo;t need another app. I needed an AI that could see the full picture.
          Within weeks it caught what the clinic missed for 2 years: iron deficiency from required blood
          donations, and hormone imbalances from a protocol change they said &ldquo;wouldn&rsquo;t matter.&rdquo;
        </p>
        <p style="margin-bottom:0;">
          <strong>- Joe, Founder</strong><br/>
          <a href="https://www.instagram.com/josephtolandsr/" target="_blank" rel="noopener" style="color: var(--blue);">
            Follow the journey on Instagram &rarr;
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- ===== BOTTOM CTA ===== -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Stop guessing. Start proving.</h2>
      <p class="sub" style="text-align:center; margin: 0 auto 20px; max-width:50ch;">
        Upload your labs. Sync your wearables. Ask your AI anything.
        Available on iOS and Android.
      </p>

      <div class="store-badges" style="justify-content:center;">
        <a href="https://play.google.com/store/apps/details?id=com.teknicalsolutionz.HealthCoachApp" target="_blank" rel="noopener" data-track="cta-google-play">
          <img src="/badges/google-play-badge.svg" alt="Get it on Google Play" height="60" />
        </a>
        <a href="https://apps.apple.com/us/app/ai-health-coach-app/id6758858875" target="_blank" rel="noopener" data-track="cta-app-store">
          <img src="/badges/app-store-badge.svg" alt="Download on the App Store" height="60" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===== COMPLIANCE ===== -->
  <section class="section" style="padding-top:0;">
    <div class="container" style="text-align:center;">
      <div class="small" style="margin-top:10px;">
        <a href="/privacy">Privacy Policy</a> &middot;
        <a href="/data-deletion">Data Deletion</a> &middot;
        <a href="/terms">Terms of Use</a> &middot;
        <a href="/garmin">Garmin</a> &middot;
        <a href="/whoop">WHOOP</a>
      </div>
    </div>
  </section>

</BaseLayout>
